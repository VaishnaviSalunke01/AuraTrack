# Copy this file to .env and fill in values. DO NOT commit the real .env file.

# Django
SECRET=
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=

# Database (optional: set DB_HOST for Postgres)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis / Celery
REDIS_URL=redis://redis:6379
CELERY_REDIS_URL=

# External APIs (set keys if you want provider integrations)
TMDB_API=
MAL_API=
IGDB_ID=
IGDB_SECRET=
BGG_API_TOKEN=
STEAM_API_KEY=
COMICVINE_API=
TRAKT_API=
TRAKT_API_SECRET=
ANILIST_ID=
ANILIST_SECRET=
SIMKL_ID=
SIMKL_SECRET=

# Feature flags
ADMIN_ENABLED=0
TRACK_TIME=1

# Other
VERSION=dev

# Social account providers in JSON (optional)
# SOCIALACCOUNT_PROVIDERS={}
